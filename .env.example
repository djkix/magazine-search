# Copy this file to .env and fill in real values. Never commit .env.
#
# TLS termination and the public domain are handled by your reverse proxy
# (Nginx Proxy Manager) in front of this stack, not by docker-compose here.

# ---- General ----
TZ=Europe/Paris

# Tag des images applicatives déployées. Laisser « latest » revient à
# redéployer un contenu différent à chaque merge, sans possibilité de revenir
# en arrière : préférer un tag de version précis (ex. v1.4.2) en production.
IMAGE_TAG=latest

# Host port app-frontend is published on; this is the only port your reverse
# proxy needs to forward to (e.g. NPM proxy host -> <docker-host-ip>:${FRONTEND_PORT}).
# The frontend proxies /api/* to app-backend internally over the Docker network.
FRONTEND_PORT=3000
# app-backend n'est plus publié sur l'hôte (voir « expose » dans
# docker-compose.yml) : il n'est joignable que depuis le réseau Docker interne.
# Cette variable n'est donc plus utilisée ; conservée pour mémoire.
# BACKEND_PORT=8000

# ---- Postgres ----
POSTGRES_USER=magazines
# Générer : openssl rand -hex 24
POSTGRES_PASSWORD=__REMPLACER__
POSTGRES_DB=magazines
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Meilisearch ----
# Obligatoire, 16 caractères minimum. Générer : openssl rand -hex 24
MEILI_MASTER_KEY=__REMPLACER__
MEILI_HOST=http://meilisearch:7700
# Délai maximum des appels HTTP vers Meilisearch, en secondes. Sans borne, un
# Meilisearch saturé immobilise l'unique worker d'ingestion.
MEILI_TIMEOUT_SECONDS=15

# ---- Backend / Auth ----
# Identifiant client OAuth Google (PAS un secret, contrairement aux clés
# ci-dessus — c'est l'identifiant public déclaré côté Google Cloud
# Console, "Identifiants" > "ID client OAuth" > type "Application web").
# Sans lui, la connexion Google est simplement indisponible. Le frontend le
# récupère via GET /auth/google/client-id, pas via une variable NEXT_PUBLIC_* :
# l'image frontend est construite une seule fois par la CI et partagée par
# tous les self-hosters, une NEXT_PUBLIC_* y serait figée pour tout le monde.
GOOGLE_CLIENT_ID=
# Classification automatique des nouveaux articles par Gemini (facultatif).
# Sans clé API, la fonctionnalité est inactive : le rattachement par mots-clés
# et l'import manuel de taxonomie fonctionnent comme avant. Les limites ci-dessous
# sont celles du palier gratuit pour ce modèle (page « Limite de débit » d'AI
# Studio) : à ajuster si votre compte en a d'autres. L'application s'arrête
# avant de les atteindre (2 requêtes/jour gardées en réserve).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RPM=5
GEMINI_TPM=250000
GEMINI_RPD=20
GEMINI_TIMEOUT_SECONDS=120
# Obligatoire, 32 caractères minimum. Le backend REFUSE de démarrer si cette
# variable est absente, trop courte, ou laissée à une valeur d'exemple.
# Générer : openssl rand -hex 32
JWT_SECRET_KEY=__REMPLACER__
# JWT_ALGORITHM n'est plus lue : l'algorithme est figé dans le code
# (app/security.py), pour qu'une variable mal renseignée ne puisse pas
# affaiblir la signature des jetons.
# JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Public domain NPM exposes this app on (must match exactly, scheme included).
# Laisser vide en déploiement normal : le frontend relaie /api/* sur sa propre
# origine, aucune origine tierce n'a besoin d'être autorisée.
BACKEND_CORS_ORIGINS=

# Expose /api/docs, /api/redoc et /api/openapi.json. Fermés par défaut : ils
# cartographient toute la surface d'API. À n'activer qu'en développement local.
ENABLE_API_DOCS=false

# Compte administrateur créé au premier démarrage si aucun admin n'existe.
# Laisser les deux variables VIDES pour ne créer aucun compte automatiquement.
# Si renseignées : mot de passe de 12 caractères minimum, refusé s'il vaut
# « changeme » ou un autre exemple connu. À changer après la première connexion.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Journalisation ----
# Répertoire des logs applicatifs. La valeur par défaut convient au conteneur ;
# la surcharger permet de lancer le backend hors Docker, où /data n'existe pas.
# LOG_DIR=/data/logs

# ---- Traitement OCR ----
# Délai maximum du sous-processus ocrmypdf, en secondes. Doit rester sous le
# job_timeout RQ (30 min) pour que l'échec soit reporté sur le numéro plutôt
# que par la mort brutale du job. 1500 s = 25 min.
OCR_TIMEOUT_SECONDS=1500

# ---- NAS mount (host path, mounted read-only into containers) ----
NAS_MOUNT_PATH=/mnt/nas/magazines

# ---- Sauvegarde vers le NAS (service « sauvegarde ») ----
# Chaque nuit : base, données de l'application (PDF retraités, couvertures) et
# configuration de la stack (compose, ce .env) dans un dossier daté du NAS,
# en NFS, sept jours gardés, sans chiffrement. Facultative : décommenter
# COMPOSE_PROFILES pour l'activer, puis renseigner les deux variables NAS_*.
# Ce dossier de sauvegarde n'a rien à voir avec NAS_MOUNT_PATH ci-dessus
# (la bibliothèque de PDF, lue seulement). Valeurs réelles jamais dans le dépôt.
# COMPOSE_PROFILES=sauvegarde
# Options de montage NFS, par exemple : addr=<IP du NAS>,nfsvers=4.1,soft,timeo=150,retrans=3
NAS_OPTIONS=
# Export NFS et dossier de sauvegarde, avec le deux-points, par exemple :
# :/volumeN/<partage>/<dossier> (`showmount -e <IP du NAS>` donne l'export)
NAS_CHEMIN=
# Heure de la sauvegarde quotidienne, heure de Paris (3 par défaut).
SAUVEGARDE_HEURE=3
