# Copy this file to .env and fill in real values. Never commit .env.
#
# TLS termination and the public domain are handled by your reverse proxy
# (Nginx Proxy Manager) in front of this stack, not by docker-compose here.

# ---- General ----
TZ=Europe/Paris

# Host ports app-frontend / app-backend are published on, for NPM to proxy to
# (e.g. proxy host -> <docker-host-ip>:${FRONTEND_PORT}, custom location /api -> <docker-host-ip>:${BACKEND_PORT}).
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---- Postgres ----
POSTGRES_USER=magazines
POSTGRES_PASSWORD=changeme
POSTGRES_DB=magazines
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Meilisearch ----
MEILI_MASTER_KEY=changeme-generate-a-long-random-key
MEILI_HOST=http://meilisearch:7700

# ---- Backend / Auth ----
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Public domain NPM exposes this app on (must match exactly, scheme included).
BACKEND_CORS_ORIGINS=https://magazines.example.com

# Bootstrap admin account created on first backend startup if no admin exists.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme

# ---- NAS mount (host path, mounted read-only into containers) ----
NAS_MOUNT_PATH=/mnt/nas/magazines

# ---- Frontend ----
# Public URL the browser calls; NPM must proxy <domain>/api to app-backend (see README).
NEXT_PUBLIC_API_URL=https://magazines.example.com/api
