# Copy this file to .env and fill in real values. Never commit .env.

# ---- General ----
DOMAIN=magazines.example.com
LETSENCRYPT_EMAIL=admin@example.com
TZ=Europe/Paris

# ---- Postgres ----
POSTGRES_USER=magazines
POSTGRES_PASSWORD=changeme
POSTGRES_DB=magazines
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Meilisearch ----
MEILI_MASTER_KEY=changeme-generate-a-long-random-key
MEILI_HOST=http://meilisearch:7700

# ---- Backend / Auth ----
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=https://magazines.example.com

# Bootstrap admin account created on first backend startup if no admin exists.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme

# ---- NAS mount (host path, mounted read-only into containers) ----
NAS_MOUNT_PATH=/mnt/nas/magazines

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://magazines.example.com/api
